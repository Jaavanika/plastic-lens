{
  "name": "plasticlens-firebase",
  "private": true,
  "type": "module",
  "description": "Firestore/Storage security-rule tests and Firebase tooling for PlasticLens",
  "scripts": {
    "test:rules": "firebase emulators:exec --only firestore,storage --project demo-plasticlens \"node --test tests/rules.test.js\"",
    "deploy:rules": "firebase deploy --only firestore:rules,storage",
    "deploy:hosting": "firebase deploy --only hosting"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^4.0.1",
    "firebase": "^11.10.0",
    "firebase-tools": "^14.11.0",
    "http-server": "^14.1.1",
    "lighthouse": "^13.6.0"
  }
}
